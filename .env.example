# Server
PORT=3000
NODE_ENV=development
APP_BASE_URL=http://localhost:3000
APP_NAME=AuthSystem

# JWT
JWT_SECRET=your-very-long-random-jwt-secret-here

# Database (MySQL)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_db_password_here
DB_NAME=auth_system

# Infobip SMS
INFOBIP_API_KEY=your_infobip_api_key_here
INFOBIP_BASE_URL=https://xxxxx.api.infobip.com
INFOBIP_SENDER=ServiceSMS

# Mailgun Email
MAILGUN_API_KEY=your_mailgun_api_key_here
MAILGUN_DOMAIN=sandboxyourdomain.mailgun.org
EMAIL_FROM=postmaster@sandboxyourdomain.mailgun.org
